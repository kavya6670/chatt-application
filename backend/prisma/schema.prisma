// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  DEVELOPER
  FINANCE
}

enum ConversationType {
  DIRECT
  GROUP
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  ONGOING
  ENDED
  FAILED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PermissionType {
  EVERYONE
  DEPARTMENT
  ROLE
  SPECIFIC
}

// ============================================
// CORE ENTITIES
// ============================================

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  conversations   Conversation[]
  documents       Document[]
  aiConversations AIConversation[]

  @@index([slug])
}

model User {
  id                String     @id @default(uuid())
  employeeId        String     @unique
  email             String     @unique
  name              String
  passwordHash      String
  role              Role       @default(DEVELOPER)
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  isActive          Boolean    @default(true)
  mustResetPassword Boolean    @default(true)
  lastLogin         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sentMessages             Message[]                 @relation("MessageSender")
  conversationParticipants ConversationParticipant[]
  initiatedCalls           Call[]                    @relation("CallInitiator")
  callParticipants         CallParticipant[]
  calendarEvents           CalendarEvent[]
  aiConversations          AIConversation[]
  documentPermissions      DocumentPermission[]
  uploadedDocuments        Document[]

  @@index([employeeId])
  @@index([email])
  @@index([departmentId])
  @@index([role])
}

// ============================================
// CONVERSATIONS & MESSAGING
// ============================================

model Conversation {
  id           String           @id @default(uuid())
  type         ConversationType
  name         String? // Only for group conversations
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]

  @@index([departmentId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean      @default(false) // For group conversations
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    String[] // Array of file URLs
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ============================================
// CALLS
// ============================================

model Call {
  id              String        @id @default(uuid())
  type            CallType
  status          CallStatus    @default(INITIATED)
  initiatorId     String
  initiator       User          @relation("CallInitiator", fields: [initiatorId], references: [id])
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  liveKitRoomName String?
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int? // Duration in seconds
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  participants CallParticipant[]

  @@index([initiatorId])
  @@index([conversationId])
  @@index([status])
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([callId, userId])
  @@index([callId])
  @@index([userId])
}

// ============================================
// CALENDAR
// ============================================

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callId      String? // Link to a scheduled call
  location    String?
  isAllDay    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([startTime])
}

// ============================================
// DOCUMENTS & RAG
// ============================================

model Document {
  id           String               @id @default(uuid())
  title        String?
  description  String?
  fileName     String?
  fileKey      String?
  fileSize     Int?
  filename     String?
  originalName String?
  mimeType     String?
  size         Int?
  storagePath  String?
  status       DocumentStatus       @default(PENDING)
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id])
  uploadedById String?
  uploadedBy   User?                @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime             @default(now())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  processedAt  DateTime?
  errorMessage String?
  chunks       DocumentChunk[]
  permissions  DocumentPermission[]

  @@index([departmentId])
  @@index([status])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  chunkIndex Int // Position in the document
  embedding  String? // pgvector embedding or JSON string
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model DocumentPermission {
  id             String         @id @default(uuid())
  documentId     String
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         Role?
  departmentId   String?
  permissionType PermissionType
  createdAt      DateTime       @default(now())

  @@index([documentId])
  @@index([userId])
  @@index([departmentId])
}

// ============================================
// AI ASSISTANT
// ============================================

model AIConversation {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  query        String
  response     String
  sources      String[] // Document IDs used as sources
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([departmentId])
}
